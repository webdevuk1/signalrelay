//@version=6
indicator("Hope & Failure Strategy (Burst Reversal) V1", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=5000)

// ---------------------------
// Simple UI first
// ---------------------------
var table statusTable = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 0), frame_color=color.new(color.white, 0))
var table statsTable = table.new(position.bottom_right, 2, 6, bgcolor=color.new(color.black, 70), frame_color=color.new(color.white, 50), frame_width=1)

// ---------------------------
// Inputs (basic by default)
// ---------------------------
simpleMode = input.bool(true, "Simple Mode (recommended)", tooltip="Hides advanced controls; uses a clean default set of reversal modules.", group="Simple")

enableShorts = input.bool(true, "Enable Shorts", group="Sides")
enableLongs = input.bool(true, "Enable Longs", group="Sides")

showStatus = input.bool(true, "Show Status Banner", group="Visuals")
showLines = input.bool(true, "Show Entry/SL/TP Lines", group="Visuals")
showFibLevels = input.bool(true, "Show Fibonacci Levels", group="Visuals")
showGoldenZone = input.bool(true, "Show Golden Zone (burst range)", group="Visuals")
showBurstLevels = input.bool(true, "Show Burst High/Low Lines", group="Visuals", tooltip="Plots horizontal lines at burst high and low when a burst has been detected.")
showStats = input.bool(true, "Show Win/Loss Stats Table", group="Visuals")

sequenceLen = input.int(20, "Last outcomes shown", minval=5, maxval=50, group="Stats")

// ---------------------------
// Burst detection (setup window)
// ---------------------------
burstLookback = input.int(20, "Burst Lookback (swing ref)", minval=5, maxval=100, group="Burst Setup")
burstAtrMult = input.float(0.5, "Burst body vs ATR (min body)", minval=0.1, maxval=10.0, step=0.1, group="Burst Setup", tooltip="Lower = more bursts detected (e.g. 0.5 for choppy charts)")
volLen = input.int(20, "Volume SMA Length", minval=5, maxval=200, group="Burst Setup")
volMult = input.float(1.0, "Volume spike multiplier", minval=0.1, maxval=10.0, step=0.1, group="Burst Setup", tooltip="Lower = more bursts (1.0 = any volume)")

useStructure = input.bool(true, "Use Structure Break (pivot BOS)", group="Reversal Filters")
useRSI = input.bool(true, "Use RSI Rollover", group="Reversal Filters")
useFibFilter = input.bool(true, "Use Fibonacci Filter", group="Reversal Filters")

// Simple mode forces the core modules
if simpleMode
    useStructure := true
    useRSI := true
    useFibFilter := true

swingStrength = input.int(5, "Swing Strength (pivots)", minval=2, maxval=20, group="Reversal Filters")

atrLength = input.int(14, "ATR Length (SL/TP)", minval=5, maxval=50, group="Risk")
slMultiplier = input.float(1.0, "SL ATR Multiplier", minval=0.2, maxval=10.0, step=0.1, group="Risk")

tp4On = input.bool(false, "Enable TP4 (1:8)", group="Risk")
tp5On = input.bool(false, "Enable TP5 (1:10)", group="Risk")
tp6On = input.bool(false, "Enable TP6 (1:12)", group="Risk")

maxHoldBarsOn = input.bool(false, "Max Hold Bars (safety)", group="Exit")
maxHoldBars = input.int(400, "Max Hold Bars", minval=10, maxval=5000, group="Exit")
exitOnOppositeReversal = input.bool(true, "Exit on Opposite Reversal (flip)", group="Exit")

// RSI settings
rsiLen = input.int(14, "RSI Length", minval=5, maxval=50, group="RSI")
rsiShortLevel = input.float(60, "RSI short rollover level", minval=40, maxval=80, step=1, group="RSI")
rsiLongLevel = input.float(40, "RSI long rollover level", minval=20, maxval=60, step=1, group="RSI")

// Fibonacci settings (filter + visuals)
fibTriggerMode = input.string("Break", "Fib trigger style", options=["Break", "Reclaim"], group="Fib")
fibLookbackStored = input.int(20, "Fib retracement anchor (not used for math)", minval=5, maxval=200, group="Fib", tooltip="This script uses the stored burst high/low for Fib math.")

useFib382 = input.bool(true, "Use Fib 0.382", group="Fib")
useFib5 = input.bool(true, "Use Fib 0.5", group="Fib")

fib382 = input.float(0.382, "Fib 0.382 value", group="Fib", inline="f1")
fib5 = input.float(0.5, "Fib 0.5 value", group="Fib", inline="f2")

// ---------------------------
// State machine
// ---------------------------
// 0=IDLE, 1=SHORT_BIAS(wait), 2=IN_SHORT(trade), 3=LONG_BIAS(wait), 4=IN_LONG(trade)
var int state = 0

// Burst context
var int burstDir = 0              // 1=burst up, -1=burst down
var float burstHigh = na         // impulse peak for burst up, or swing high before burst down
var float burstLow = na          // impulse trough for burst down, or swing low before burst up
var int burstPeakBar = na

// Structure tracking after burst peak
var float lastSwingLowAfterBurst = na
var int lastSwingLowAfterBurstBar = na
var float lastSwingHighAfterBurst = na
var int lastSwingHighAfterBurstBar = na

// Structure tracking after the active trade opened (used for flipping exits)
var float lastSwingHighAfterTrade = na
var int lastSwingHighAfterTradeBar = na
var float lastSwingLowAfterTrade = na
var int lastSwingLowAfterTradeBar = na

// Trade tracking (single trade at a time)
var int openTradeDir = 0   // 1 or -1 when we should open a new trade this bar (used to avoid modifying globals in functions)
var bool tradeActive = false
var int tradeDir = 0 // 1 long, -1 short
var int tradeOpenBar = na
var float entryPrice = na
var float slPrice = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na
var float tp6 = na

var bool tp1Hit = false
var bool tp2Hit = false
var bool tp3Hit = false
var bool tp4Hit = false
var bool tp5Hit = false
var bool tp6Hit = false

// Win/loss stats + last sequence
var int totalTrades = 0
var int tp1Wins = 0
var int tp2Wins = 0
var int tp3Wins = 0
var int tp4Wins = 0
var int tp5Wins = 0
var int tp6Wins = 0
var string[] tradeHistory = array.new_string()

// Visual lines
var line lEntry = na
var line lSL = na
var line lTP1 = na
var line lTP2 = na
var line lTP3 = na
var line lTP4 = na
var line lTP5 = na
var line lTP6 = na

var label entrySignalLabel = na

// Fib visuals
var line fibL1 = na
var line fibL2 = na
var line fibDownA = na
var line fibDownB = na
var line hlineBurstHigh = na
var line hlineBurstLow = na
var box goldenZoneBox = na

// ---------------------------
// Helper: candle-burst detection
// ---------------------------
atr = ta.atr(atrLength)
volSMA = ta.sma(volume, volLen)

bodyBull = close > open ? (close - open) : 0.0
bodyBear = open > close ? (open - close) : 0.0

// Call ta.* at global scope for consistent execution every bar
highestHighPrev = ta.highest(high, burstLookback)[1]
lowestLowPrev = ta.lowest(low, burstLookback)[1]

// Burst UP: strong bullish body + volume spike + makes a fresh local high
burstUpCandidate =
     close > open and
     bodyBull >= atr * burstAtrMult and
     volume >= volSMA * volMult and
     high >= highestHighPrev

// Burst DOWN: strong bearish body + volume spike + makes a fresh local low
burstDownCandidate =
     open > close and
     bodyBear >= atr * burstAtrMult and
     volume >= volSMA * volMult and
     low <= lowestLowPrev

// ---------------------------
// Helper: RSI rollover
// ---------------------------
rsi = ta.rsi(close, rsiLen)

// Call ta.crossover/crossunder at global scope for consistent execution every bar
rsiCrossOverLong = ta.crossover(rsi, rsiLongLevel)
rsiCrossUnderShort = ta.crossunder(rsi, rsiShortLevel)

rsiShortOk = rsiCrossUnderShort
rsiLongOk = rsiCrossOverLong

// Precompute RSI flip conditions at global scope so they are not used inside conditional blocks
rsiFlipUpOk = useRSI ? rsiCrossOverLong : true
rsiFlipDownOk = useRSI ? rsiCrossUnderShort : true

// ---------------------------
// Helper: structure breaks after burst
// ---------------------------
pivHi = ta.pivothigh(high, swingStrength, swingStrength)
pivLo = ta.pivotlow(low, swingStrength, swingStrength)

if not na(pivLo)
    pivBar = bar_index - swingStrength
    if burstDir == 1 and not na(burstPeakBar) and pivBar > burstPeakBar
        lastSwingLowAfterBurst := pivLo
        lastSwingLowAfterBurstBar := pivBar
    if tradeActive and tradeDir == 1 and not na(tradeOpenBar) and pivBar > tradeOpenBar
        // For long -> short flips, track latest swing low after the trade opened.
        lastSwingLowAfterTrade := pivLo
        lastSwingLowAfterTradeBar := pivBar

if not na(pivHi)
    pivBar = bar_index - swingStrength
    if burstDir == -1 and not na(burstPeakBar) and pivBar > burstPeakBar
        lastSwingHighAfterBurst := pivHi
        lastSwingHighAfterBurstBar := pivBar
    if tradeActive and tradeDir == -1 and not na(tradeOpenBar) and pivBar > tradeOpenBar
        // For short -> long flips, track latest swing high after the trade opened.
        lastSwingHighAfterTrade := pivHi
        lastSwingHighAfterTradeBar := pivBar

structureShortOk = useStructure ? (not na(lastSwingLowAfterBurst) and close < lastSwingLowAfterBurst and close[1] >= lastSwingLowAfterBurst) : true
structureLongOk = useStructure ? (not na(lastSwingHighAfterBurst) and close > lastSwingHighAfterBurst and close[1] <= lastSwingHighAfterBurst) : true

// ---------------------------
// Helper: Fib filter (uses stored burst high/low)
// ---------------------------
fibRange = burstHigh - burstLow

fibPriceForRatio(_ratio) =>
    // For burst up (shorts): fib retracement levels sit below burstHigh: burstHigh - range*ratio
    // For burst down (longs): fib retracement levels sit above burstLow: burstLow + range*ratio
    burstDir == 1 ? (burstHigh - fibRange * _ratio) : (burstLow + fibRange * _ratio)

fibShortOk_break =
     (useFib382 and close < fibPriceForRatio(fib382)) or
     (useFib5 and close < fibPriceForRatio(fib5))

fibShortOk_reclaim =
     ((useFib382 and close < fibPriceForRatio(fib382) and close[1] >= fibPriceForRatio(fib382)) or
      (useFib5 and close < fibPriceForRatio(fib5) and close[1] >= fibPriceForRatio(fib5)))

fibLongOk_break =
     (useFib382 and close > fibPriceForRatio(fib382)) or
     (useFib5 and close > fibPriceForRatio(fib5))

fibLongOk_reclaim =
     ((useFib382 and close > fibPriceForRatio(fib382) and close[1] <= fibPriceForRatio(fib382)) or
      (useFib5 and close > fibPriceForRatio(fib5) and close[1] <= fibPriceForRatio(fib5)))

fibShortOk = fibTriggerMode == "Reclaim" ? fibShortOk_reclaim : fibShortOk_break
fibLongOk = fibTriggerMode == "Reclaim" ? fibLongOk_reclaim : fibLongOk_break

fibShortOk := useFibFilter ? fibShortOk : true
fibLongOk := useFibFilter ? fibLongOk : true

// ---------------------------
// Burst -> initialize context
// ---------------------------
// Call ta.* at global scope for consistent execution every bar
lowestLowLookback = ta.lowest(low, burstLookback)
highestHighLookback = ta.highest(high, burstLookback)

newBurstUp = burstUpCandidate and state == 0
newBurstDown = burstDownCandidate and state == 0

if newBurstUp
    burstDir := 1
    burstHigh := high
    burstLow := lowestLowLookback
    burstPeakBar := bar_index
    lastSwingLowAfterBurst := na
    lastSwingLowAfterBurstBar := na
    lastSwingHighAfterBurst := na
    lastSwingHighAfterBurstBar := na
    state := enableShorts ? 1 : 0

if newBurstDown
    burstDir := -1
    burstHigh := highestHighLookback
    burstLow := low
    burstPeakBar := bar_index
    lastSwingLowAfterBurst := na
    lastSwingLowAfterBurstBar := na
    lastSwingHighAfterBurst := na
    lastSwingHighAfterBurstBar := na
    state := enableLongs ? 3 : 0

// ---------------------------
// Fib visuals for the current burst
// ---------------------------
f_deleteLine(_ln) =>
    if not na(_ln)
        line.delete(_ln)

if newBurstUp or newBurstDown
    // Delete existing Fib lines
    f_deleteLine(fibL1)
    f_deleteLine(fibL2)
    f_deleteLine(fibDownA)
    f_deleteLine(fibDownB)
    fibL1 := na
    fibL2 := na
    fibDownA := na
    fibDownB := na

    if showFibLevels and useFibFilter and not na(burstHigh) and not na(burstLow) and fibRange != 0
        // Draw the fib retracement anchors
        if useFib382
            fibL1 := line.new(bar_index, fibPriceForRatio(fib382), bar_index + 50, fibPriceForRatio(fib382), extend=extend.right, color=color.new(color.yellow, 0), width=1)
        if useFib5
            fibL2 := line.new(bar_index, fibPriceForRatio(fib5), bar_index + 50, fibPriceForRatio(fib5), extend=extend.right, color=color.new(color.orange, 0), width=1)

        // Draw a couple of “downside landing” style levels for context
        // For burst up: fibDownA/B sit below burstLow; for burst down: fibDownA/B sit above burstHigh (mirrored)
        fibDownA := line.new(bar_index, burstDir == 1 ? (burstLow - fibRange * 0.618) : (burstHigh + fibRange * 0.618), bar_index + 50, burstDir == 1 ? (burstLow - fibRange * 0.618) : (burstHigh + fibRange * 0.618), extend=extend.right, color=color.new(color.red, 0), width=1)
        fibDownB := line.new(bar_index, burstDir == 1 ? (burstLow - fibRange * 1.0) : (burstHigh + fibRange * 1.0), bar_index + 50, burstDir == 1 ? (burstLow - fibRange * 1.0) : (burstHigh + fibRange * 1.0), extend=extend.right, color=color.new(color.red, 0), width=1)

// ---------------------------
// Golden Zone (burst range) – visible whenever we're in SHORT/LONG bias
// ---------------------------
if showGoldenZone and (state == 1 or state == 3) and not na(burstHigh) and not na(burstLow) and not na(burstPeakBar)
    zoneTop = math.max(burstHigh, burstLow)
    zoneBottom = math.min(burstHigh, burstLow)
    zoneLeftBar = math.max(burstPeakBar, bar_index - 4000)
    if na(goldenZoneBox)
        goldenZoneBox := box.new(zoneLeftBar, zoneTop, bar_index + 50, zoneBottom, border_color=color.new(color.yellow, 0), bgcolor=color.new(color.yellow, 60), border_width=2)
    else
        box.set_right(goldenZoneBox, bar_index + 50)
        box.set_top(goldenZoneBox, zoneTop)
        box.set_bottom(goldenZoneBox, zoneBottom)
else
    if not na(goldenZoneBox)
        box.delete(goldenZoneBox)
        goldenZoneBox := na

// Redraw Fib lines every bar when in SHORT/LONG bias (only "Show Fibonacci Levels" controls visibility)
if showFibLevels and (state == 1 or state == 3) and not na(burstHigh) and not na(burstLow) and not na(burstPeakBar) and fibRange != 0
    f_deleteLine(fibL1)
    f_deleteLine(fibL2)
    f_deleteLine(fibDownA)
    f_deleteLine(fibDownB)
    // Clamp leftBar so it's within allowed drawing range (Pine rejects bar indices too far in the past)
    leftBar = math.max(burstPeakBar, bar_index - 4000)
    rightBar = bar_index + 50
    if useFib382
        fibL1 := line.new(leftBar, fibPriceForRatio(fib382), rightBar, fibPriceForRatio(fib382), extend=extend.right, color=color.new(color.yellow, 0), width=2)
    if useFib5
        fibL2 := line.new(leftBar, fibPriceForRatio(fib5), rightBar, fibPriceForRatio(fib5), extend=extend.right, color=color.new(color.orange, 0), width=2)
    fibDownA := line.new(leftBar, burstDir == 1 ? (burstLow - fibRange * 0.618) : (burstHigh + fibRange * 0.618), rightBar, burstDir == 1 ? (burstLow - fibRange * 0.618) : (burstHigh + fibRange * 0.618), extend=extend.right, color=color.new(color.red, 0), width=1)
    fibDownB := line.new(leftBar, burstDir == 1 ? (burstLow - fibRange * 1.0) : (burstHigh + fibRange * 1.0), rightBar, burstDir == 1 ? (burstLow - fibRange * 1.0) : (burstHigh + fibRange * 1.0), extend=extend.right, color=color.new(color.red, 0), width=1)

// ---------------------------
// Reversal confirmations
// ---------------------------
reversalShortConfirmed =
     state == 1 and
     not na(burstPeakBar) and
     bar_index > burstPeakBar and
     structureShortOk and
     (useRSI ? rsiShortOk : true) and
     fibShortOk

reversalLongConfirmed =
     state == 3 and
     not na(burstPeakBar) and
     bar_index > burstPeakBar and
     structureLongOk and
     (useRSI ? rsiLongOk : true) and
     fibLongOk

// ---------------------------
// Trade open/resolve
// ---------------------------
f_deleteLineSet() =>
    if showLines
        f_deleteLine(lEntry)
        f_deleteLine(lSL)
        f_deleteLine(lTP1)
        f_deleteLine(lTP2)
        f_deleteLine(lTP3)
        f_deleteLine(lTP4)
        f_deleteLine(lTP5)
        f_deleteLine(lTP6)

    // entrySignalLabel is cleared by caller (cannot modify globals inside a function in Pine)

// ---------------------------
// Entry triggers
// ---------------------------
if reversalShortConfirmed
    state := 2
    openTradeDir := -1

if reversalLongConfirmed
    state := 4
    openTradeDir := 1

// ---------------------------
// Trade monitoring (TP/SL hit detection + resolution)
// ---------------------------
// Update hit flags
if tradeActive
    stopHit = false
    if tradeDir == 1
        if high >= tp1
            tp1Hit := true
        if high >= tp2
            tp2Hit := true
        if high >= tp3
            tp3Hit := true
        if tp4On and high >= tp4
            tp4Hit := true
        if tp5On and high >= tp5
            tp5Hit := true
        if tp6On and high >= tp6
            tp6Hit := true

        stopHit := low <= slPrice
    else
        if low <= tp1
            tp1Hit := true
        if low <= tp2
            tp2Hit := true
        if low <= tp3
            tp3Hit := true
        if tp4On and low <= tp4
            tp4Hit := true
        if tp5On and low <= tp5
            tp5Hit := true
        if tp6On and low <= tp6
            tp6Hit := true

        stopHit := high >= slPrice

    // Exit conditions
    // Short -> Long flip uses: structure break up (pivot high after trade open) + RSI rollover up.
    structureFlipUpOk =
         useStructure and not na(lastSwingHighAfterTrade) and close > lastSwingHighAfterTrade and close[1] <= lastSwingHighAfterTrade
    structureFlipDownOk =
         useStructure and not na(lastSwingLowAfterTrade) and close < lastSwingLowAfterTrade and close[1] >= lastSwingLowAfterTrade

    oppUp = exitOnOppositeReversal and state == 2 and (useStructure ? structureFlipUpOk : true) and rsiFlipUpOk
    oppDown = exitOnOppositeReversal and state == 4 and (useStructure ? structureFlipDownOk : true) and rsiFlipDownOk
    maxHoldHit = maxHoldBarsOn and (bar_index - tradeOpenBar) >= maxHoldBars

    if stopHit or maxHoldHit or oppUp or oppDown
        // If opposite reversal triggered, optionally flip
        flipToLong = oppUp and enableLongs
        flipToShort = oppDown and enableShorts

        // Inlined f_resolveTrade (cannot modify globals in function)
        totalTrades += 1
        primaryWin = tp1Hit
        if primaryWin
            tp1Wins += 1
        if tp2Hit
            tp2Wins += 1
        if tp3Hit
            tp3Wins += 1
        if tp4On and tp4Hit
            tp4Wins += 1
        if tp5On and tp5Hit
            tp5Wins += 1
        if tp6On and tp6Hit
            tp6Wins += 1
        array.push(tradeHistory, primaryWin ? "W" : "L")
        if array.size(tradeHistory) > sequenceLen
            array.shift(tradeHistory)
        tradeActive := false
        tradeDir := 0
        entryPrice := na
        slPrice := na
        tp1 := na
        tp2 := na
        tp3 := na
        tp4 := na
        tp5 := na
        tp6 := na

        if flipToLong
            state := 4
            openTradeDir := 1
        else if flipToShort
            state := 2
            openTradeDir := -1
        else
            state := 0

// Run open-trade logic in main script (Pine cannot modify globals inside functions)
if openTradeDir != 0
    _dir = openTradeDir
    if not na(entrySignalLabel)
        label.delete(entrySignalLabel)
    entrySignalLabel := na
    tp1Hit := false
    tp2Hit := false
    tp3Hit := false
    tp4Hit := false
    tp5Hit := false
    tp6Hit := false
    f_deleteLineSet()
    entry = open
    stopDist = atr * slMultiplier
    tradeDir := _dir
    tradeActive := true
    tradeOpenBar := bar_index
    lastSwingHighAfterTrade := na
    lastSwingHighAfterTradeBar := na
    lastSwingLowAfterTrade := na
    lastSwingLowAfterTradeBar := na
    entryPrice := entry
    if _dir == 1
        slPrice := entryPrice - stopDist
        tp1 := entryPrice + stopDist * 2.0
        tp2 := entryPrice + stopDist * 4.0
        tp3 := entryPrice + stopDist * 6.0
        tp4 := entryPrice + stopDist * 8.0
        tp5 := entryPrice + stopDist * 10.0
        tp6 := entryPrice + stopDist * 12.0
    else
        slPrice := entryPrice + stopDist
        tp1 := entryPrice - stopDist * 2.0
        tp2 := entryPrice - stopDist * 4.0
        tp3 := entryPrice - stopDist * 6.0
        tp4 := entryPrice - stopDist * 8.0
        tp5 := entryPrice - stopDist * 10.0
        tp6 := entryPrice - stopDist * 12.0
    if showLines
        lEntry := line.new(bar_index, entryPrice, bar_index + 80, entryPrice, extend=extend.none, color=color.new(color.blue, 0), width=2)
        lSL := line.new(bar_index, slPrice, bar_index + 80, slPrice, extend=extend.none, color=color.new(color.red, 0), width=2, style=line.style_dashed)
        lTP1 := line.new(bar_index, tp1, bar_index + 80, tp1, extend=extend.none, color=color.new(color.green, 0), width=2)
        lTP2 := line.new(bar_index, tp2, bar_index + 80, tp2, extend=extend.none, color=color.new(color.lime, 0), width=2)
        lTP3 := line.new(bar_index, tp3, bar_index + 80, tp3, extend=extend.none, color=color.new(color.lime, 0), width=2)
        lTP4 := line.new(bar_index, tp4, bar_index + 80, tp4, extend=extend.none, color=color.new(color.lime, tp4On ? 0 : 100), width=2)
        lTP5 := line.new(bar_index, tp5, bar_index + 80, tp5, extend=extend.none, color=color.new(color.lime, tp5On ? 0 : 100), width=2)
        lTP6 := line.new(bar_index, tp6, bar_index + 80, tp6, extend=extend.none, color=color.new(color.lime, tp6On ? 0 : 100), width=2)
    entrySignalLabel := label.new(bar_index, entryPrice, _dir == 1 ? "BUY" : "SELL", style=_dir == 1 ? label.style_label_up : label.style_label_down, textcolor=color.white, color=_dir == 1 ? color.new(color.green, 0) : color.new(color.red, 0), size=size.small)
    openTradeDir := 0

// Extend Entry/SL/TP lines every bar while trade is active so they stay visible
if showLines and tradeActive and not na(lEntry)
    line.set_x2(lEntry, bar_index + 50)
    if not na(lSL)
        line.set_x2(lSL, bar_index + 50)
    if not na(lTP1)
        line.set_x2(lTP1, bar_index + 50)
    if not na(lTP2)
        line.set_x2(lTP2, bar_index + 50)
    if not na(lTP3)
        line.set_x2(lTP3, bar_index + 50)
    if not na(lTP4)
        line.set_x2(lTP4, bar_index + 50)
    if not na(lTP5)
        line.set_x2(lTP5, bar_index + 50)
    if not na(lTP6)
        line.set_x2(lTP6, bar_index + 50)

// ---------------------------
// Status banner + tables
// ---------------------------
statusText = switch state
    0 => "WAITING"
    1 => "SHORT BIAS"
    2 => "GET SHORT"
    3 => "LONG BIAS"
    4 => "GET LONG"
    => "WAITING"

if showStatus
    table.cell(statusTable, 0, 0, statusText, text_color=color.white, bgcolor=state == 2 or state == 4 ? color.new(color.blue, 0) : color.new(color.gray, 0))

if showStats
    winRate = totalTrades > 0 ? (tp1Wins * 100.0 / totalTrades) : na
    lastSeq = ""
    histSize = array.size(tradeHistory)
    if histSize > 0
        for i = 0 to math.min(sequenceLen - 1, histSize - 1)
            idx = histSize - 1 - i
            lastSeq := lastSeq + array.get(tradeHistory, idx) + (i == sequenceLen - 1 ? "" : " ")
    // Render from newest to oldest; keep it compact.

    // Row 0: Win rate
    table.cell(statsTable, 0, 0, "WinRate", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(statsTable, 1, 0, na(winRate) ? "-" : str.tostring(winRate, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.black, 0))

    // Row 1: TP1 W/L
    table.cell(statsTable, 0, 1, "TP1 W/L", text_color=color.white)
    table.cell(statsTable, 1, 1, str.tostring(tp1Wins) + "/" + str.tostring(totalTrades), text_color=color.white)

    // Row 2-4: TP2/TP3/TP4(5/6) wins (count of trades that reached each TP)
    table.cell(statsTable, 0, 2, "TP2", text_color=color.white)
    table.cell(statsTable, 1, 2, str.tostring(tp2Wins), text_color=color.white)
    table.cell(statsTable, 0, 3, "TP3", text_color=color.white)
    table.cell(statsTable, 1, 3, str.tostring(tp3Wins), text_color=color.white)
    table.cell(statsTable, 0, 4, "TP4/5/6", text_color=color.white)
    table.cell(statsTable, 1, 4, (tp4On ? str.tostring(tp4Wins) : "-") + " / " + (tp5On ? str.tostring(tp5Wins) : "-") + " / " + (tp6On ? str.tostring(tp6Wins) : "-"), text_color=color.white)

    // Row 5: last outcomes
    table.cell(statsTable, 0, 5, "Last", text_color=color.white)
    table.cell(statsTable, 1, 5, array.size(tradeHistory) == 0 ? "-" : lastSeq, text_color=color.white)

// ---------------------------
// Safety: if we are not in any trade state, ensure flags are clean
// ---------------------------
if state == 0 and tradeActive
    tradeActive := false

// ---------------------------
// Always-visible burst levels: two persistent lines extended every bar when in bias
// ---------------------------
if showBurstLevels and (state == 1 or state == 3) and not na(burstHigh) and not na(burstLow) and not na(burstPeakBar)
    safeLeftBar = math.max(burstPeakBar, bar_index - 4000)
    if na(hlineBurstHigh)
        hlineBurstHigh := line.new(safeLeftBar, burstHigh, bar_index + 50, burstHigh, extend=extend.both, color=color.new(color.yellow, 0), width=2)
    else
        line.set_x2(hlineBurstHigh, bar_index + 50)
        line.set_y1(hlineBurstHigh, burstHigh)
        line.set_y2(hlineBurstHigh, burstHigh)
    if na(hlineBurstLow)
        hlineBurstLow := line.new(safeLeftBar, burstLow, bar_index + 50, burstLow, extend=extend.both, color=color.new(color.orange, 0), width=2)
    else
        line.set_x2(hlineBurstLow, bar_index + 50)
        line.set_y1(hlineBurstLow, burstLow)
        line.set_y2(hlineBurstLow, burstLow)
else
    if not na(hlineBurstHigh)
        line.delete(hlineBurstHigh)
        hlineBurstHigh := na
    if not na(hlineBurstLow)
        line.delete(hlineBurstLow)
        hlineBurstLow := na

// ALWAYS show two lines so something is on chart every time (no conditions)
recentHigh = ta.highest(high, burstLookback)
recentLow = ta.lowest(low, burstLookback)
plot(recentHigh, "Range High", color=color.new(color.yellow, 30), linewidth=2)
plot(recentLow, "Range Low", color=color.new(color.orange, 30), linewidth=2)

// Fib levels when in bias
inBias = (state == 1 or state == 3)
hasBurstRange = not na(burstHigh) and not na(burstLow) and not na(fibRange)
validRange = hasBurstRange and (fibRange > 0 or fibRange < 0)
canPlotFib = showFibLevels and inBias and validRange
fib382Price = canPlotFib ? (useFib382 ? fibPriceForRatio(fib382) : na) : na
fib5Price = canPlotFib ? (useFib5 ? fibPriceForRatio(fib5) : na) : na
plot(fib382Price, "Fib 0.382", color=color.new(color.yellow, 0), linewidth=2)
plot(fib5Price, "Fib 0.5", color=color.new(color.orange, 0), linewidth=2)

// Mark burst and entry
plotshape(newBurstUp, "Burst Up", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)
plotshape(newBurstDown, "Burst Down", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(reversalShortConfirmed, "Short Entry", shape.triangledown, location.abovebar, color.new(color.purple, 0), size=size.normal)
plotshape(reversalLongConfirmed, "Long Entry", shape.triangleup, location.belowbar, color.new(color.blue, 0), size=size.normal)

// Force indicator to appear in legend
plot(close, "Hope & Failure", color=color.new(color.teal, 100), linewidth=1, display=display.none)
// Paste at end of Hope & Failure V1. TV alert: Any alert() function call → SignalRelay webhook.

sr_hf_payload(string event, string side) =>
    string st = switch state
        0 => "WAITING"
        1 => "SHORT_BIAS"
        2 => "GET_SHORT"
        3 => "LONG_BIAS"
        4 => "GET_LONG"
        => "WAITING"
    float wr = totalTrades > 0 ? tp1Wins * 100.0 / totalTrades : na
    string payload = "{"
    payload += '"source":"hope-failure",'
    payload += '"event":"' + event + '",'
    payload += '"side":"' + side + '",'
    payload += '"status":"' + st + '",'
    payload += '"ticker":"' + syminfo.ticker + '",'
    payload += '"exchange":"' + syminfo.prefix + '",'
    payload += '"interval":"' + timeframe.period + '",'
    payload += '"time":"' + str.tostring(time) + '",'
    payload += '"timenow":"' + str.tostring(timenow) + '",'
    payload += '"open":"' + str.tostring(open) + '",'
    payload += '"high":"' + str.tostring(high) + '",'
    payload += '"low":"' + str.tostring(low) + '",'
    payload += '"close":"' + str.tostring(close) + '",'
    payload += '"volume":"' + str.tostring(volume) + '",'
    payload += '"burstHigh":"' + str.tostring(burstHigh) + '",'
    payload += '"burstLow":"' + str.tostring(burstLow) + '",'
    payload += '"fib382":"' + str.tostring(fibPriceForRatio(fib382)) + '",'
    payload += '"fib5":"' + str.tostring(fibPriceForRatio(fib5)) + '",'
    payload += '"entry":"' + str.tostring(entryPrice) + '",'
    payload += '"sl":"' + str.tostring(slPrice) + '",'
    payload += '"tp1":"' + str.tostring(tp1) + '",'
    payload += '"tp2":"' + str.tostring(tp2) + '",'
    payload += '"tp3":"' + str.tostring(tp3) + '",'
    payload += '"tp4":"' + str.tostring(tp4) + '",'
    payload += '"tp5":"' + str.tostring(tp5) + '",'
    payload += '"tp6":"' + str.tostring(tp6) + '",'
    payload += '"rsi":"' + str.tostring(rsi, "#.##") + '",'
    payload += '"atr":"' + str.tostring(atr, "#.##") + '",'
    payload += '"winRate":"' + str.tostring(wr, "#.##") + '"'
    payload += "}"
    payload

if reversalLongConfirmed and barstate.isconfirmed
    alert(sr_hf_payload("long_entry", "LONG"), alert.freq_once_per_bar)
if reversalShortConfirmed and barstate.isconfirmed
    alert(sr_hf_payload("short_entry", "SHORT"), alert.freq_once_per_bar)
if newBurstUp and barstate.isconfirmed
    alert(sr_hf_payload("burst_up", "SHORT_BIAS"), alert.freq_once_per_bar)
if newBurstDown and barstate.isconfirmed
    alert(sr_hf_payload("burst_down", "LONG_BIAS"), alert.freq_once_per_bar)
