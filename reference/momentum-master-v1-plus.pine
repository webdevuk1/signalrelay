//@version=6
indicator("Momentum Master v1 Plus", overlay=true, max_bars_back=5000, max_labels_count=500)

// ==================== SETTINGS LAYOUT (Ordered by Priority) ====================
// === 1. MOST IMPORTANT - Start Here ===
var g_main = "Strategy Selection"
var g_risk = "Risk Management"

// === 2. STRATEGY CONFIGURATION (Click strategy above to see settings) ===
var g_ema = "   └─ EMA Settings"
var g_rsi = "   └─ RSI Reversion Settings"
var g_breakout = "   └─ Breakout Settings"
var g_macd = "   └─ MACD Settings"
var g_bollinger = "   └─ Bollinger Bands Settings"
var g_volume = "   └─ Volume Breakout Settings"

// === 3. DISPLAY OPTIONS ===
var g_display = "Chart Display & Tables"

// === 4. SIGNAL CONFLUENCE & FILTERS ===
var g_confluence = "Signal Confluence System"
var g_filters = "Signal Filters (Optional)"

// === 5. ADVANCED TOOLS ===
var g_fvg = "Fair Value Gaps (FVG)"
var g_orderblock = "Order Blocks"
var g_liquidity = "Liquidity Zones"
var g_fibonacci = "Fibonacci Extensions"
var g_fib_core = "Fibonacci Core Settings"
var g_fib_display = "Fibonacci Display Options"
var g_fib_golden = "Fibonacci Golden Zone"
var g_fib_highlights = "Fibonacci Extension Highlights"
var g_fib_additional_neg = "Additional Negative Levels"
var g_poc = "POC (Point of Control)"
var g_divergence = "Divergence Detection"
var g_context = "Market Context"
var g_gann = "Gann Fan Analysis"

// === 6. VISUAL APPEARANCE (Last - Fine-tune after setup) ===
var g_font_sizes = "Visual Appearance Settings"

// ==================== INPUTS ====================
// Set relaxed mode to false (stock mode) by default
relaxedMode = false

// === MAIN STRATEGY SELECTOR ===
strategyMode = input.string("Disabled", "Strategy Mode", options=["EMA Crossover", "RSI Mean Reversion", "Breakout", "MACD Crossover", "Bollinger Bands", "Volume Breakout", "Disabled"], group=g_main, tooltip="Select which trading logic to use. All strategies share the same risk management system.")

// === EMA Crossover Configuration ===
emaMode = input.string("Standard", "EMA Speed", options=["Standard", "Fast", "Slow", "Custom"], group=g_ema, tooltip="Choose EMA speed:\nStandard (9/21): Balanced\nFast (7/17): More sensitive\nSlow (13/26): Less sensitive\nCustom: Set your own")
customFastEMA = input.int(9, "Custom Fast EMA", minval=3, maxval=50, group=g_ema, tooltip="Only used in Custom mode")
customSlowEMA = input.int(21, "Custom Slow EMA", minval=10, maxval=100, group=g_ema, tooltip="Only used in Custom mode")

// Determine EMA periods based on selected mode
emaFast = emaMode == "Standard" ? 9 : emaMode == "Fast" ? 7 : emaMode == "Slow" ? 13 : customFastEMA
emaSlow = emaMode == "Standard" ? 21 : emaMode == "Fast" ? 17 : emaMode == "Slow" ? 26 : customSlowEMA

// ==================== RISK MANAGEMENT ====================
atrLength = input.int(14, "ATR Length for SL", minval=5, maxval=30, group=g_risk, tooltip="Period for ATR calculation used in stop loss placement")
slMultiplier = input.float(1.0, "SL ATR Multiplier", minval=0.5, maxval=10.0, group=g_risk, tooltip="Multiplier for ATR to determine stop loss distance from entry")
enableTP4 = input.bool(false, "Enable TP4 (1:8)", group=g_risk, tooltip="Enable fourth take profit level at 8x risk")
enableTP5 = input.bool(false, "Enable TP5 (1:10)", group=g_risk, tooltip="Enable fifth take profit level at 10x risk")
enableTP6 = input.bool(false, "Enable TP6 (1:12)", group=g_risk, tooltip="Enable sixth take profit level at 12x risk")

// Take Profit Settings (ratios are fixed)
tp1Ratio = 2.0
tp2Ratio = 4.0
tp3Ratio = 6.0
tp4Ratio = 8.0
tp5Ratio = 10.0
tp6Ratio = 12.0

// ==================== CHART DISPLAY ====================
showLines = input.bool(true, "Show Entry/SL/TP Lines", group=g_display, tooltip="Display entry, stop loss, and take profit lines on the chart")
lineLength = input.int(30, "Line Length (bars)", minval=10, maxval=100, group=g_display, tooltip="Number of bars to extend trade lines forward on the chart")
defaultLineLength = 30  // Default line length for older trades
showWinLossLabels = input.bool(true, "Show Win/Loss Labels on Chart", group=g_display, tooltip="Displays up to 500 individual W/L labels for trade verification")

// === Table Display Controls ===
showPerformanceTable = input.bool(true, "Show Performance Stats Table", group=g_display, tooltip="Display performance statistics table (win rates for each TP level)")
showSignalOverviewTable = input.bool(true, "Show Signal Overview Table", group=g_display, tooltip="Display technical analysis overview (RSI, ATR, ADX, etc.)")
showRiskManagementTable = input.bool(true, "Show Risk Management Table", group=g_display, tooltip="Display risk management summary (direction, losses, win rate, last trades)")

// ==================== SIGNAL FILTERS ====================
useRSIFilter = input.bool(false, "Use RSI Filter (Avoid Extremes)", group=g_filters, tooltip="Only allow trades when RSI is not in extreme overbought/oversold zones")
rsiCalcPeriod = input.int(14, "RSI Length", minval=5, maxval=50, group=g_filters, tooltip="Period for RSI calculation")
rsiOverbought = input.float(70, "RSI Overbought", minval=60, maxval=90, group=g_filters, tooltip="RSI level considered overbought")
rsiOversold = input.float(30, "RSI Oversold", minval=10, maxval=40, group=g_filters, tooltip="RSI level considered oversold")
volMultiplier = input.float(1.1, "Volume Multiplier", minval=1.0, maxval=3.0, group=g_filters, tooltip="Volume confirmation multiplier")
useADXFilter = input.bool(false, "Use ADX Filter (Avoid Choppy Markets)", group=g_filters, tooltip="Only allow trades when ADX indicates trending market conditions")
adxThreshold = input.int(20, "ADX Threshold", minval=10, maxval=50, group=g_filters, tooltip="Minimum ADX value required to confirm trending market conditions")

// ==================== SIGNAL CONFLUENCE SYSTEM ====================
enableConfluenceFilter = input.bool(false, "Enable Signal Confluence Filter", group=g_confluence, tooltip="Only execute trades with minimum confluence score for higher win rate")
minConfluenceStars = input.int(3, "Minimum Stars Required", minval=1, maxval=5, group=g_confluence, tooltip="Minimum confluence rating (1-5 stars) required to execute trades")
showConfluenceScore = input.bool(true, "Show Confluence Score in Tables", group=g_confluence, tooltip="Display signal confluence rating in performance tables")
useStrategyWeighting = input.bool(true, "Use Strategy Weight Rankings", group=g_confluence, tooltip="Weight stronger strategies higher in confluence calculation")

// ==================== MARKET ANALYSIS TOOLS ====================
// === Fair Value Gaps (FVG) ===
showFVG = input.bool(true, "Show Fair Value Gaps Boxes", group=g_fvg, tooltip="Toggle to show/hide FVG boxes on the chart")
showFVGLabels = input.bool(false, "Show Fair Value Gaps Labels", group=g_fvg, tooltip="Toggle to show/hide FVG labels on the chart")
fvgShowLast = input.int(2, "Show Last FVGs", minval=1, group=g_fvg, tooltip="Number of most recent FVGs to display on chart")
filterSmallFVG = input.bool(true, "Filter: Min Size", group=g_fvg, tooltip="Filter out FVGs smaller than minimum ATR size")
fvgATRLen = input.int(50, "ATR Length", minval=1, group=g_fvg, tooltip="Period for ATR calculation used in FVG size filtering")
fvgATRMult = input.float(0.8, "Min Size x ATR", minval=0, step=0.1, group=g_fvg, tooltip="Minimum FVG size as ATR multiplier")

// FVG Fixed Settings
extendFVG = true // Always extend FVG until filled
keepFilledFVG = true // Always keep filled FVGs visible
keepFilledFVGMax = 1 // Always keep 1 filled FVG visible
bullFVGColor = color.new(#00ff68, 80) // Bullish FVG Fill (fixed)
bearFVGColor = color.new(#ff0008, 80) // Bearish FVG Fill (fixed)
bullFVGLineColor = color.new(#00ff68, 0) // Bullish FVG Border (fixed)
bearFVGLineColor = color.new(#ff0008, 0) // Bearish FVG Border (fixed)
bullFVGColorFilled = color.new(color.gray, 80) // Bullish FVG Filled (fixed)
bearFVGColorFilled = color.new(color.gray, 80) // Bearish FVG Filled (fixed)
fvgSizeThreshold = filterSmallFVG ? ta.atr(fvgATRLen) * fvgATRMult : 0.0

// === Order Block Detection ===
showOrderBlockVisuals = input.bool(false, "Show Order Block Boxes", group=g_orderblock, tooltip="Toggle to show/hide order block boxes on the chart")
showOrderBlockLabels = input.bool(false, "Show Order Block Labels", group=g_orderblock, tooltip="Toggle to show/hide order block labels on the chart")
useOrderBlockFilter = input.bool(false, "Align with Order Block Direction", group=g_filters, tooltip="Only allow trades in the direction of the most recent order block")
orderBlockShowLast = input.int(2, "Show Last OBs", minval=1, group=g_orderblock, tooltip="Number of most recent order blocks to display on chart")
orderBlockExtendBars = input.int(20, "OB Box Length", minval=1, maxval=100, group=g_orderblock, tooltip="Number of bars to extend order block boxes on the chart")
filterSmallOrderBlock = input.bool(true, "Filter: Min Size", group=g_orderblock, tooltip="Filter out order blocks smaller than minimum ATR size")
orderBlockATRLen = input.int(50, "ATR Length", minval=1, group=g_orderblock, tooltip="Period for ATR calculation used in order block size filtering")
orderBlockATRMult = input.float(0.8, "Min Size x ATR", minval=0, step=0.1, group=g_orderblock, tooltip="Minimum order block size as ATR multiplier")

// === POC Display Settings ===
showAllPOCLines = input.bool(true, "Show All POC Lines", group=g_poc, tooltip="Master toggle to show/hide all POC lines")
showVolumePOC = input.bool(true, "Show Volume Profile POC", group=g_poc)
volumePOCLookback = input.int(30, "Volume POC Lookback", group=g_poc, minval=20, maxval=200, tooltip="Number of bars to analyze for volume profile")
showSessionPOC = input.bool(true, "Show Session POC", group=g_poc)
showDailyPOC = input.bool(true, "Show Daily POC", group=g_poc)
showWeeklyPOC = input.bool(false, "Show Weekly POC", group=g_poc)
pocLineWidth = input.int(2, "POC Line Width", group=g_poc, minval=1, maxval=4)
pocLineStyle = input.string("Dashed", "POC Line Style", group=g_poc, options=["Solid", "Dashed", "Dotted"])
showPOCLabels = input.bool(true, "Show POC Labels", group=g_poc)

// === Fibonacci Extensions ===
showFib = input.bool(true, "Show Fibonacci Extensions", group=g_fibonacci)

// Core Settings
fibLookback = input.int(20, "Swing Detection Lookback", minval=5, maxval=100, group=g_fib_core)

// Display Options
showRetracements = input.bool(true, "Show Retracement Levels", group=g_fib_display)
showExtensions = input.bool(true, "Show Extension Levels", group=g_fib_display)
addNegativeLevels = input.bool(false, "Negative Levels", group=g_fib_display, tooltip="-0.27, -0.618")
showExtendedFibLevels = input.bool(false, "Show Extended Fibonacci Levels (4.236-24.180)", group=g_fib_display, tooltip="Master toggle to enable/disable all extended Fibonacci levels. Individual level toggles can still be used for fine control.")
fibLineStyle = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group=g_fib_display)
fibLineWidth = input.int(2, "Line Width", minval=1, maxval=4, group=g_fib_display)
fibShowLabels = input.bool(true, "Show Level Labels", group=g_fib_display)
fibExtMajorWidth = input.int(3, "Major Extension Width", minval=2, maxval=5, group=g_fib_display, tooltip="Line width for critical extension levels (0%, 100%, 161.8%, 261.8%)")
fibExtMinorWidth = input.int(1, "Minor Extension Width", minval=1, maxval=3, group=g_fib_display, tooltip="Line width for intermediate extension levels")

// Golden Zone
showGoldenZone = input.bool(true, "Show Golden Zone Highlight", group=g_fib_golden, tooltip="Highlight the 61.8%-78.6% retracement zone (high probability reversal area)")
goldenZoneColor = input.color(color.new(#FFD700, 85), "Golden Zone Color", group=g_fib_golden, tooltip="Color for the golden zone highlight")
showHistoricalGoldenZones = input.bool(true, "Show Historical Golden Zones", group=g_fib_golden, tooltip="Display multiple historical golden zones from previous swings for confluence analysis")
maxHistoricalGoldenZones = input.int(3, "Number of Zones to Keep", minval=1, maxval=30, group=g_fib_golden, tooltip="Maximum number of historical golden zones to display simultaneously")
fadeOlderZones = input.bool(true, "Fade Older Zones", group=g_fib_golden, tooltip="Apply progressive transparency to older golden zones (newest = full opacity)")

// Extension Highlights
show1618Extension = input.bool(true, "Highlight 161.8% Extension", group=g_fib_highlights, tooltip="Highlight the 161.8% Fibonacci extension (major target zone)")
ext1618Color = input.color(color.new(#FFD700, 70), "161.8% Extension Color", group=g_fib_highlights)
showExtZone100 = input.bool(true, "Highlight 100% Extension Zone", group=g_fib_highlights, tooltip="Highlight the 100% Fibonacci extension (base extension level)")
ext100Color = input.color(color.new(#00FFAA, 70), "100% Extension Color", group=g_fib_highlights)
showExtZone261 = input.bool(true, "Highlight 261.8% Extension Zone", group=g_fib_highlights, tooltip="Highlight the 261.8% Fibonacci extension (major swing extension)")
ext261Color = input.color(color.new(#FF9500, 70), "261.8% Extension Color", group=g_fib_highlights)
showExtZoneNeg027 = input.bool(false, "Highlight -0.27 Extension Zone", group=g_fib_highlights, tooltip="Highlight the -0.27 Fibonacci extension zone")
extNeg027Color = input.color(color.new(#9D27B0, 70), "-0.27 Extension Color", group=g_fib_highlights)
showExtZoneNeg0618 = input.bool(false, "Highlight -0.618 Extension Zone", group=g_fib_highlights, tooltip="Highlight the -0.618 Fibonacci extension zone")
extNeg0618Color = input.color(color.new(#E91E63, 70), "-0.618 Extension Color", group=g_fib_highlights)

// Extended Fibonacci Levels (default OFF)
showExtZone4236 = input.bool(false, "Highlight 4.236 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 4.236 Fibonacci extension zone")
ext4236Color = input.color(color.new(#FF6B00, 70), "4.236 Extension Color", group=g_fib_highlights)
showExtZone5236 = input.bool(false, "Highlight 5.236 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 5.236 Fibonacci extension zone")
ext5236Color = input.color(color.new(#FF8800, 70), "5.236 Extension Color", group=g_fib_highlights)
showExtZone6854 = input.bool(false, "Highlight 6.854 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 6.854 Fibonacci extension zone")
ext6854Color = input.color(color.new(#FFAA00, 70), "6.854 Extension Color", group=g_fib_highlights)
showExtZone7854 = input.bool(false, "Highlight 7.854 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 7.854 Fibonacci extension zone")
ext7854Color = input.color(color.new(#FFCC00, 70), "7.854 Extension Color", group=g_fib_highlights)
showExtZone9472 = input.bool(false, "Highlight 9.472 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 9.472 Fibonacci extension zone")
ext9472Color = input.color(color.new(#FFEE00, 70), "9.472 Extension Color", group=g_fib_highlights)
showExtZone11090 = input.bool(false, "Highlight 11.090 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 11.090 Fibonacci extension zone")
ext11090Color = input.color(color.new(#FFFF33, 70), "11.090 Extension Color", group=g_fib_highlights)
showExtZone13708 = input.bool(false, "Highlight 13.708 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 13.708 Fibonacci extension zone")
ext13708Color = input.color(color.new(#FFFF66, 70), "13.708 Extension Color", group=g_fib_highlights)
showExtZone16326 = input.bool(false, "Highlight 16.326 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 16.326 Fibonacci extension zone")
ext16326Color = input.color(color.new(#FFFF99, 70), "16.326 Extension Color", group=g_fib_highlights)
showExtZone18944 = input.bool(false, "Highlight 18.944 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 18.944 Fibonacci extension zone")
ext18944Color = input.color(color.new(#FFFFCC, 70), "18.944 Extension Color", group=g_fib_highlights)
showExtZone21562 = input.bool(false, "Highlight 21.562 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 21.562 Fibonacci extension zone")
ext21562Color = input.color(color.new(#FFFFEE, 70), "21.562 Extension Color", group=g_fib_highlights)
showExtZone24180 = input.bool(false, "Highlight 24.180 Extension Zone", group=g_fib_highlights, tooltip="Highlight the 24.180 Fibonacci extension zone")
ext24180Color = input.color(color.new(#FFFFFF, 70), "24.180 Extension Color", group=g_fib_highlights)

// Additional Negative Levels (separate from existing Negative Levels toggle)
enableAdditionalNegLevels = input.bool(false, "Enable Additional Negative Levels", group=g_fib_additional_neg, tooltip="Master toggle for additional negative extension and retracement levels")

// Additional Negative Extension Levels
showNeg0382Ext = input.bool(false, "Show -0.382 Extension", group=g_fib_additional_neg, tooltip="Display -0.382 Fibonacci extension level")
showNeg05Ext = input.bool(false, "Show -0.5 Extension", group=g_fib_additional_neg, tooltip="Display -0.5 Fibonacci extension level")
showNeg0786Ext = input.bool(false, "Show -0.786 Extension", group=g_fib_additional_neg, tooltip="Display -0.786 Fibonacci extension level")
showNeg10Ext = input.bool(false, "Show -1.0 Extension", group=g_fib_additional_neg, tooltip="Display -1.0 Fibonacci extension level (full reversal)")
showNeg1272Ext = input.bool(false, "Show -1.272 Extension", group=g_fib_additional_neg, tooltip="Display -1.272 Fibonacci extension level")
showNeg1618Ext = input.bool(false, "Show -1.618 Extension", group=g_fib_additional_neg, tooltip="Display -1.618 Fibonacci extension level (major reversal)")

// Additional Negative Retracement Levels
showNeg05Ret = input.bool(false, "Show -0.5 Retracement", group=g_fib_additional_neg, tooltip="Display -0.5 Fibonacci retracement level")
showNeg0786Ret = input.bool(false, "Show -0.786 Retracement", group=g_fib_additional_neg, tooltip="Display -0.786 Fibonacci retracement level")

// Highlight zones for major additional negative levels
showExtZoneNeg10 = input.bool(false, "Highlight -1.0 Extension Zone", group=g_fib_additional_neg, tooltip="Highlight the -1.0 Fibonacci extension zone")
extNeg10Color = input.color(color.new(#FF1744, 70), "-1.0 Extension Color", group=g_fib_additional_neg)
showExtZoneNeg1618 = input.bool(false, "Highlight -1.618 Extension Zone", group=g_fib_additional_neg, tooltip="Highlight the -1.618 Fibonacci extension zone")
extNeg1618Color = input.color(color.new(#C51162, 70), "-1.618 Extension Color", group=g_fib_additional_neg)

// === Buy and Sell Liquidity Zones ===
liqLookback = input.int(20, "Liquidity Lookback", minval=5, group=g_liquidity)
lineLengthLiq = input.int(150, "Liquidity Line Length", minval=5, group=g_liquidity)
maxLiqZones = input.int(5, "Max Zones to Display", minval=1, maxval=20, group=g_liquidity)

// === RSI Mean Reversion Settings ===
strategy2RSIOversold = input.float(30, "RSI Oversold (Buy)", minval=15, maxval=45, group=g_rsi, tooltip="RSI level to buy. Lower = more selective, higher win rate")
strategy2RSIOverbought = input.float(70, "RSI Overbought (Sell)", minval=55, maxval=85, group=g_rsi, tooltip="RSI level to sell. Higher = more selective, higher win rate")
usePriceLevelFilter = input.bool(false, "Require Near Support/Resistance", group=g_rsi, tooltip="Only enter when price is near local highs/lows for higher win rate")
useStrongCandleFilter = input.bool(false, "Require Strong Candle Body", group=g_rsi, tooltip="Only enter on strong bullish/bearish candles (>50% body)")
strategy2VolumeMultiplier = input.float(1.0, "Volume Multiplier", minval=1.0, maxval=3.0, group=g_rsi, tooltip="Multiplier for volume confirmation. Higher = more selective")

// === Breakout Settings ===
breakoutLookback = input.int(20, "Lookback Period", minval=5, maxval=50, group=g_breakout, tooltip="Number of bars to look back for breakout levels")

// === MACD Settings ===
macdFastLen = input.int(12, "Fast Length", minval=5, maxval=50, group=g_macd, tooltip="MACD fast moving average length")
macdSlowLen = input.int(26, "Slow Length", minval=10, maxval=100, group=g_macd, tooltip="MACD slow moving average length")
macdSigLen = input.int(9, "Signal Length", minval=5, maxval=50, group=g_macd, tooltip="MACD signal line length")

// === Bollinger Bands Settings ===
bbLength = input.int(20, "BB Length", minval=5, maxval=50, group=g_bollinger, tooltip="Bollinger Bands moving average length")
bbStdDev = input.float(2.0, "Standard Deviation", minval=1.0, maxval=3.0, group=g_bollinger, tooltip="Number of standard deviations for bands")

// === Volume Breakout Settings ===
volumeSurgeMultiplier = input.float(2.0, "Volume Surge Multiplier", minval=1.5, maxval=5.0, group=g_volume, tooltip="Volume must be this many times average to trigger signal")
priceStrengthATRMult = input.float(0.5, "Price Strength (x ATR)", minval=0.1, maxval=2.0, group=g_volume, tooltip="Minimum price movement in ATR terms for signal")

// === Gann Fan Settings ===
showGannFan = input.bool(true, "Show Gann Fan Lines", group=g_gann, tooltip="Toggle to show/hide Gann Fan lines on the chart")
useAutoGannLookback = input.bool(true, "Auto-adjust lookback by timeframe", group=g_gann, tooltip="Automatically sets optimal lookback based on chart timeframe")
manualGannLookback = input.int(50, "Manual Lookback (if auto disabled)", minval=10, maxval=500, group=g_gann, tooltip="Manual pivot lookback when auto-adjust is disabled")
gannExtendBars = input.int(100, "Line Extension (bars)", minval=20, maxval=500, group=g_gann, tooltip="Number of bars to extend Gann Fan lines forward")
gannLineWidth = input.int(1, "Line Width", minval=1, maxval=3, group=g_gann, tooltip="Width of Gann Fan lines")
gannShowLabels = input.bool(false, "Show Angle Labels", group=g_gann, tooltip="Show angle degree labels on Gann Fan lines")
// Auto-detect market type and set appropriate ATR multiplier
instrumentType = syminfo.type
autoGannATRMultiplier = instrumentType == "crypto" ? 15.0 :  // Crypto: more volatile
                       instrumentType == "forex" ? 12.0 :  // Forex: moderately volatile
                       instrumentType == "stock" ? 10.0 :  // Stock: balanced
                       instrumentType == "indice" ? 12.0 : // Indices: moderately volatile
                       instrumentType == "cfd" ? 13.0 :   // CFDs: variable volatility
                       10.0  // Default fallback

// Create dynamic label showing current value and market type
marketTypeLabel = instrumentType == "crypto" ? "Crypto" :
                 instrumentType == "forex" ? "Forex" :
                 instrumentType == "stock" ? "Stock" :
                 instrumentType == "indice" ? "Index" :
                 instrumentType == "cfd" ? "CFD" :
                 "Other"

useAutoATRMultiplier = input.bool(true, "Auto Angle Steepness by Market", group=g_gann, tooltip="Automatically adjusts angle steepness based on your instrument type. Crypto gets flatter angles (15.0 for volatile markets), stocks get steeper angles (10.0 for calmer markets). Turn this off to set angles manually.")

manualGannATRMultiplier = input.float(10, "Angle Steepness (Manual)", minval=5, maxval=50, group=g_gann, tooltip="Make angles flatter (higher values 15–20) for volatile markets, or steeper (lower values 5–8) for calm markets. Only active when auto mode is off.")

// Use auto or manual multiplier
gannATRMultiplier = useAutoATRMultiplier ? autoGannATRMultiplier : manualGannATRMultiplier

// === Divergence Detection ===
useDivergenceFilter = false // Divergence filter removed; always allow trades without requiring divergence confirmation
showMFIDiv = input.bool(true, "Show MFI Divergences", group=g_divergence)
showDivergenceDebug = input.bool(false, "Show Divergence Debug Labels", group=g_divergence)
divergenceLookback = input.int(100, "Divergence Lookback Period", group=g_divergence, minval=5, maxval=500)
minBarsBetween = input.int(10, "Min Bars Between Divergences", group=g_divergence, minval=1, maxval=100)

// Advanced Divergence Thresholds
rsiDivThreshold = input.float(1.5, "RSI Divergence Threshold", minval=0.01, group=g_divergence)
priceDivThreshold = input.float(0.05, "Price Divergence Threshold", minval=0.0001, group=g_divergence)
mfiDivThreshold = input.float(2.0, "MFI Divergence Threshold", minval=0.01, group=g_divergence)

// ==================== MARKET CONTEXT ====================
showKeyLevels = input.bool(true, "Show Session High/Low Lines", group=g_context, tooltip="Draws lines for Session High/Low")
sessionHLlookback = input.int(10, "Session HL Lookback", minval=5, maxval=50, group=g_context)
showSwingPoints = input.bool(true, "Show Swing Points", group=g_context)
swingStrength = input.int(5, "Swing Point Strength", minval=2, maxval=10, group=g_context)

// ==================== VISUAL APPEARANCE SETTINGS ====================
// === Table Text Sizes ===
tableFontSize = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large"], group=g_font_sizes, tooltip="Font size for all table text (Performance, Signal Overview, Risk Management)")

// === Trade Label Sizes ===
