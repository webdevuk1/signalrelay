// ==================== FONT SIZE HELPER FUNCTIONS ====================
// Font Size Conversion Functions
getSizeFromString(sizeStr) =>
    switch sizeStr
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

