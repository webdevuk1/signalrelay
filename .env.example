# Optional webhook auth (add "secret":"YOUR_VALUE" in Pine JSON or header x-signalrelay-secret)
SIGNALRELAY_WEBHOOK_SECRET=

# Optional HTTP Basic password for the desk (user name ignored; any user, this password)
SIGNALRELAY_DESK_PASSWORD=

# Production persistence (Vercel Upstash integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
